// Cloudflare Worker: serves the site (static assets), the /api backend (D1 database) and stored images (KV or R2).
// See README → "Deploy" for the one-time setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-stacks",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Client-side routes like /title/past-lives fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API and stored-image requests reach the Worker; everything else is served straight from the CDN.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fyc",
      // Replace with the id printed by `npx wrangler d1 create fyc`.
      "database_id": "2bcdc1fe-a7fa-41a3-b991-6224f9204a49",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded and copied artwork, in Workers KV (free, no payment method needed).
  // Replace the id with the one printed by `npx wrangler kv namespace create fyc-media`.
  "kv_namespaces": [{ "binding": "MEDIA_KV", "id": "e3d2c1e052d3486290f6935a461fc08f" }],
  // Or use R2 instead (needs R2 enabled in the dashboard, which asks for a payment method):
  // create it with `npx wrangler r2 bucket create fyc-media`, then uncomment this line.
  // When both are set, R2 is used.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fyc-media" }],
  // Cloudflare Workers AI fills translation gaps (free daily allowance; no payment method needed).
  "ai": { "binding": "AI" },
  // Which deployed version is running; part of the catalog's ETag, so a deploy never serves a stale one.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Secrets (set with `npx wrangler secret put NAME`, never in this file):
  //   ADMIN_PASSWORD (admin login, 12+ characters)
  //   TMDB_API_KEY (optional, for "Find art" on films, TV and people)
  "observability": { "enabled": true }
}
