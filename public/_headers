# Security headers for the files Cloudflare serves without the Worker (pages, scripts, styles).
# The Worker adds the same ones to its own responses: keep this in step with worker/headers.ts
# (tests/headers.test.ts checks they match).
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
